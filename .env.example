# Configuration de docker compose : copier ce fichier en .env et l'adapter

# URLs du serveur Zimbra (obligatoires)
ZIMBRA_SOAP_URL=https://mail.domaine.fr/service/soap
ZIMBRA_REST_URL=https://mail.domaine.fr/service

# false si le serveur Zimbra utilise un certificat interne ou auto-signé
VERIFY_TLS=true

# Fuseau horaire des filtres de dates et des noms de fichiers .eml
ZONE_ID=Europe/Paris

# Version des images publiées (ex. 0.1.0) et port local de l'application
ARCHIVAGE_VERSION=latest
ARCHIVAGE_PORT=3000
