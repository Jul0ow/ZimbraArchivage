# Configuration de docker compose : copier ce fichier en .env et l'adapter

# URLs du serveur Zimbra (obligatoires)
ZIMBRA_SOAP_URL=https://mail.domaine.fr/service/soap
ZIMBRA_REST_URL=https://mail.domaine.fr/service

# false si le serveur Zimbra utilise un certificat interne ou auto-signé
VERIFY_TLS=true

# Proxy HTTP(S) par lequel joindre Zimbra (facultatif),
# de la forme http://[utilisateur:mot_de_passe@]hôte:port
ZIMBRA_PROXY_URL=

# Fuseau horaire des filtres de dates et des noms de fichiers .eml
ZONE_ID=Europe/Paris

# Clé de chiffrement des sessions (facultative), à générer avec :
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SESSION_SECRET=

# Version des images publiées (ex. 0.1.0, latest = dernière version stable)
# et port local de l'application (publié sur 127.0.0.1 uniquement)
ARCHIVAGE_VERSION=latest
ARCHIVAGE_PORT=3000
