ZIMBRA_SOAP_URL=https://mail.example.fr/service/soap
ZIMBRA_REST_URL=https://mail.example.fr/service
ZONE_ID=Europe/Paris
SEARCH_BATCH_SIZE=500
MAX_FILE_NAME_LENGTH=50
HTTP_TIMEOUT=120
VERIFY_TLS=true
DOWNLOAD_CONCURRENCY=4
MAX_CONCURRENT_EXPORTS=6
MAX_EXPORTS_PER_SESSION=2
# À mettre à false uniquement en développement, sans HTTPS
COOKIE_SECURE=true
SESSION_MAX_AGE=28800
# Clé Fernet des sessions (voir README), aléatoire au démarrage si vide
SESSION_SECRET=
